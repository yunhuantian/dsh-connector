{
  "name": "dsh-connector",
  "version": "0.2.0",
  "type": "module",
  "description": "IM/聊天平台桥接 + 主流工具深度集成（dsh-plugin-hub 可扩展类插件）：把飞书(Feishu/Lark)等 IM 的消息接入 dsh 会话，在对话中直接收发消息。设置界面内置在本插件里（DSH「设置 → 插件」卡片），凭据按 secret 语义只写不读。",
  "keywords": ["dsh-plugin", "hub-ext", "connector", "im", "feishu", "lark", "wecom", "dingtalk", "deepseek-harness"],
  "license": "MIT",
  "main": "./.dsh-plugin/index.mjs",
  "exports": {
    ".": "./.dsh-plugin/index.mjs",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    ".dsh-plugin/**/*.mjs",
    "src/**/*.js",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "categories": ["hub-ext", "notify"]
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "build:types": "tsc -p tsconfig.client-types.json",
    "build": "npm run build:types && npm run build:client",
    "typecheck": "tsc -p tsconfig.client.json --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunhuantian/dsh-connector.git"
  },
  "homepage": "https://github.com/yunhuantian/dsh-connector",
  "engines": {
    "node": ">=22.19"
  }
}
